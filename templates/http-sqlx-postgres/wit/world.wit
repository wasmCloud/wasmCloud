package wasmcloud:app@0.1.0;

/// Backend that serves the `/users` resource. The router service forwards
/// every request whose path starts with `/users` to this component over a
/// host-linked inter-component call (no socket hop).
interface users {
    /// A request the router parsed off a client socket and routed here.
    record request {
        /// HTTP method, e.g. `GET` or `POST`.
        method: string,
        /// Request path, e.g. `/users/42`.
        path: string,
        /// Raw query string without the leading `?` (empty when absent).
        query: string,
        /// Request body bytes (empty when absent).
        body: list<u8>,
    }
    /// The response the router writes back to the client socket.
    record response {
        /// HTTP status code, e.g. `200` or `404`.
        status: u16,
        /// Value for the `Content-Type` header.
        content-type: string,
        /// Response body bytes.
        body: list<u8>,
    }
    /// Handle a single routed request and return its response.
    handle: async func(req: request) -> response;
}

/// Backend that serves the `/todos` resource. Mirrors `users` with its own
/// distinct interface so the host links each backend to exactly one
/// component (an interface may be exported by only one component).
interface todos {
    record request {
        method: string,
        path: string,
        query: string,
        body: list<u8>,
    }
    record response {
        status: u16,
        content-type: string,
        body: list<u8>,
    }
    handle: async func(req: request) -> response;
}

/// The single long-lived Service. It is BOTH:
///   * the HTTP ingress + router (exports wasi:http/handler; the runtime routes
///     inbound HTTP here because this is the service), and
///   * the shared Postgres session pool (exports wasi:cli/run, which listens on
///     a loopback Postgres port and hands out pre-authenticated upstream
///     sessions).
/// The stateless `users`/`todos` components connect to the loopback pool with
/// ordinary sqlx and are invoked by the router over host-linked WIT calls.
world service {
    import wasi:sockets/types@0.3.0;
    import users;
    import todos;
    export wasi:cli/run@0.3.0;
    export wasi:http/handler@0.3.0;
}

/// The stateless `/users` backend: exports the `users` interface, invoked by
/// the service's router. Its sqlx client is ordinary p2 WASI networking; the
/// p3 boundary is the service.
world users-backend {
    export users;
}

/// The stateless `/todos` backend. Mirrors `users-backend`.
world todos-backend {
    export todos;
}
