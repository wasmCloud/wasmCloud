# Pinned CI tool versions. Bare semver (no leading `v`).
#
# Lives outside .github/workflows/ on purpose: tools-bump.yml pushes updates
# to this file with an octo-sts token (.github/chainguard/tools-bump.sts.yaml)
# that has contents and pull_requests write but not the `workflows`
# permission GitHub requires for changes under .github/workflows/. Keeping
# the pins here lets the bump PR push without widening that token.
#
# coverage.yml `source`s this file and other workflows append it to
# $GITHUB_ENV, so bump-tool-versions.mjs rejects any upstream tag that is
# not a bare numeric version before writing it here.
#
# Consumers:
#   WASM_TOOLS_VERSION  ← .github/workflows/wit.yml, .github/workflows/wash.yml
#                         (appended to $GITHUB_ENV)
#   PROTOC_VERSION      ← .github/actions/setup-protoc (read at runtime)
#   CARGO_LLVM_COV_VERSION ← .github/workflows/coverage.yml
#   GOBCO_VERSION      ← .github/workflows/coverage.yml
#
# Kept in sync by .github/workflows/tools-bump.yml.
#
# Format: KEY=VALUE, one per line (no quotes, no inline comments), so the
# non-comment lines drop straight into $GITHUB_ENV.
WASM_TOOLS_VERSION=1.263.0
PROTOC_VERSION=36.2
CARGO_LLVM_COV_VERSION=0.9.2
GOBCO_VERSION=1.3.4
