package wasmcloud:test-p3@0.1.0;

/// A p3 HTTP handler that awaits the clock before replying, built on the async
/// runtime wit-bindgen shipped before 0.59. Awaiting is what matters: a call
/// that suspends and is woken by the clock is the one that runtime's cancel
/// order traps on.
world http-legacy-async {
    import wasi:http/types@0.3.0;
    import wasi:clocks/types@0.3.0;
    import wasi:clocks/monotonic-clock@0.3.0;

    export wasi:http/handler@0.3.0;
}
