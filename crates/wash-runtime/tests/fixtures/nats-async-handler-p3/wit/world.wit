package wasmcloud:nats-async-handler-fixture;

// A P3 component handling JetStream deliveries and core NATS messages. Its
// handler is an `async fn` that awaits imported NATS calls — the shape a
// sync-signature package cannot express, because lifting a sync function with
// the async canonical ABI fails component validation, which is why
// `wasmcloud:nats@0.1.0` is async throughout.
//
// Two handler flavours is two `include` lines: both worlds carry the same
// `imports` set, so what each adds is its export.
world nats-async-handler-fixture {
    include wasmcloud:nats/js-processor@0.1.0;
    include wasmcloud:nats/subscriber@0.1.0;

    import wasi:clocks/monotonic-clock@0.3.0;
}
