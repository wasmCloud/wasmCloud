package wasmcloud:nats-async-handler-fixture;

// A P3 component handling JetStream deliveries, core NATS messages and KV
// change events. Each handler is an `async fn` that awaits imported NATS
// calls — the shape a sync-signature package cannot express, because lifting a
// sync function with the async canonical ABI fails component validation, which
// is why `wasmcloud:nats@0.1.3` is async throughout.
//
// Each handler flavour is one `include` line: every world carries the same
// `imports` set, so what each adds is its export.
world nats-async-handler-fixture {
    include wasmcloud:nats/js-processor@0.1.3;
    include wasmcloud:nats/subscriber@0.1.3;
    include wasmcloud:nats/kv-watcher@0.1.3;

    import wasi:clocks/monotonic-clock@0.3.0;
}
