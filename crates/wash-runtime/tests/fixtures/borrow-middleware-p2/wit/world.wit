package wasmcloud:borrow-test@0.1.0;

interface factory {
    resource token {
        constructor(name: string);
        greet: func() -> string;
        greets: func() -> u32;
    }

    /// Lends a `token` from inside a record, so the borrow is nested in a param.
    record lend {
        label: string,
        token: borrow<token>,
    }
}

interface consumer {
    use factory.{token, lend};

    accept: func(t: borrow<token>) -> string;

    /// Borrows `token` nested in a record, a tuple and an option.
    accept-nested: func(l: lend, pair: tuple<string, borrow<token>>, maybe: option<borrow<token>>) -> string;

    /// Takes ownership of a `token` nested in a tuple.
    adopt: func(t: tuple<string, token>) -> string;
}

interface middleware {
    use factory.{token, lend};

    /// Borrows a `token` and forwards the borrow to `consumer` without touching it.
    accept: func(t: borrow<token>) -> string;

    /// Borrows `token` nested in a record, a tuple and an option.
    accept-nested: func(l: lend, pair: tuple<string, borrow<token>>, maybe: option<borrow<token>>) -> string;

    /// Takes ownership of a `token` nested in a tuple.
    adopt: func(t: tuple<string, token>) -> string;
}

world middleware-component {
    import factory;
    import consumer;
    export middleware;
}
