package wasmcloud:ctx-race@0.1.0;

interface gate {
    hold: async func(release: future<u32>) -> string;
}

/// A middle hop: A -> relay (B) -> gate (C).
interface relay {
    hold: async func(release: future<u32>) -> string;
}

world ctx-race-middle {
    import gate;
    import wasi:cli/environment@0.3.0;
    import wasi:http/types@0.3.0;
    import wasi:http/client@0.3.0;

    export relay;
}
