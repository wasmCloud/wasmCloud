package wasmcloud:borrow-test@0.1.0;

interface factory {
    resource token {
        constructor(name: string);
        greet: func() -> string;
        greets: func() -> u32;
    }
}

interface consumer {
    use factory.{token};

    /// Borrows a `token` and calls a method on it.
    accept: func(t: borrow<token>) -> string;
}

world consumer-component {
    import factory;
    export consumer;
}
