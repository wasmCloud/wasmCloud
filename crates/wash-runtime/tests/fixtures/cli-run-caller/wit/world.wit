package wasmcloud:test-p3@0.1.0;

/// A p3 trigger service that *imports* `wasi:cli/run`, so the host links it to
/// the workload component exporting `run` and it can call that on demand.
///
/// It also exports `wasi:cli/run` (its own long-running work), so one component
/// carries the interface in both directions: an export the host co-drives and
/// an import the host routes elsewhere.
world cli-run-caller {
    import wasi:cli/run@0.3.0;
    import wasi:clocks/monotonic-clock@0.3.0;
    import wasi:http/types@0.3.0;
    export wasi:cli/run@0.3.0;
    export wasi:http/handler@0.3.0;
}
