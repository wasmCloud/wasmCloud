package acme:clirunplugin@0.1.0;

/// Host component plugin on both sides of `wasi:cli/run`.
///
/// It *imports* `run` — the one interface of `wasi:cli` the WASI base does not
/// serve — so the host resolves it to the export of a workload component bound
/// to this plugin. And it *exports* `run` as its own dispatch loop, which the
/// trigger service co-drives: a plugin that is a trigger, not a capability.
world cli-run-plugin {
    import wasi:cli/run@0.3.0;
    // A second workload-facing import, in the `result<T>` form: an error arm
    // with no payload beside an ok arm that has one.
    import acme:clirun/probe@0.1.0;
    import wasi:clocks/monotonic-clock@0.3.0;
    import wasmcloud:host/workload-call@0.1.3;
    export acme:clirun/control@0.1.0;
    export wasi:cli/run@0.3.0;
}
