package acme:secretsproxycaller@0.1.0;

/// Workload component: HTTP ingress that, per request, exercises the imported
/// `acme:secretsproxy/store` capability — which the host satisfies with the
/// `secrets-consumer-plugin` host component plugin running in its own store.
/// Not a service (no `cli/run`); each request runs under `run_concurrent`,
/// which is what lets its async capability import hop across the store
/// boundary.
world caller {
    import wasi:http/types@0.3.0;
    import acme:secretsproxy/store@0.1.0;
    export wasi:http/handler@0.3.0;
}
