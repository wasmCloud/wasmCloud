package wasmcloud:resource-test@0.1.0;

interface factory {
    resource token {
        greet: func() -> string;
    }

    make-token: async func(name: string) -> token;
    stats: func() -> tuple<u32, u32, u32>;
}

interface sink {
    use factory.{token};

    accept: async func(t: token) -> string;
    bounce: async func(t: token) -> token;
}

world res-caller {
    import factory;
    import sink;
    import wasi:http/types@0.3.0;
    import wasi:clocks/types@0.3.0;
    import wasi:cli/environment@0.3.0;
    import wasi:random/random@0.3.0;

    export wasi:http/handler@0.3.0;
}
