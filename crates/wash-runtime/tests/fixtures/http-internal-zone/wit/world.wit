package wasmcloud:http-internal-zone@0.1.0;

/// Exercises the reserved `*.wasmcloud.internal` zone end to end: resolve a
/// name, then open a raw TCP socket to what it resolved to.
///
/// The zone's whole point is that resolution and connection are gated
/// separately — resolving `host.wasmcloud.internal` always works because the
/// answer never leaves the process, while *reaching* it needs an explicit
/// per-port grant. A fixture that only resolved could not tell those apart.
world internal-zone {
    import wasi:http/types@0.3.0;
    import wasi:clocks/types@0.3.0;
    import wasi:random/random@0.3.0;
    import wasi:sockets/types@0.3.0;
    import wasi:sockets/ip-name-lookup@0.3.0;

    export wasi:http/handler@0.3.0;
}
