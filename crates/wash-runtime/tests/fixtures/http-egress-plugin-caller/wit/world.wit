package acme:httpegresscaller@0.1.0;

/// Workload component: HTTP ingress that, per request, exercises the imported
/// `acme:httpegress/fetch` capability — which the host satisfies with the
/// `http-egress-plugin` host component plugin running in its own store.
world caller {
    import wasi:http/types@0.3.0;
    import acme:httpegress/fetch@0.1.0;
    export wasi:http/handler@0.3.0;
}
