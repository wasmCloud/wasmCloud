package wasmcloud:echo-p3;

// The async counterpart of the `messaging-echo` fixture: the same echo
// behaviour, but against `wasmcloud:messaging@0.3.0`, where `handle-message`
// and `publish` are `async func`s. Exercises both directions of the async
// surface at once — the host invokes the exported handler through the
// concurrent ABI, and the guest awaits an imported `publish` from inside it.
//
// It is a *service* (exports `wasi:cli/run`) so the trigger service co-drives
// one long-lived instance: a per-message component would get a fresh linear
// memory each time, and the handled-message count could never be observed.
// `wasi:http/handler` reports that count, so a test can publish through a
// backend and read it back over HTTP — the same trick the `msg-counter` fixture
// uses for the sync surface.
world echo-p3 {
    import wasmcloud:messaging/consumer@0.3.0;
    import wasi:clocks/monotonic-clock@0.3.0;
    import wasi:http/types@0.3.0;

    export wasi:cli/run@0.3.0;
    export wasi:http/handler@0.3.0;
    export wasmcloud:messaging/handler@0.3.0;
}
