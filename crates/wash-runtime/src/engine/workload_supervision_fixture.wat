(component
  (import "wasi:http/types@0.3.0" (instance $types
    (export "request" (type (sub resource)))
    (export "response" (type (sub resource)))))
  (alias export $types "request" (type $request))
  (alias export $types "response" (type $response))
  (type $dns-error (record (field "rcode" (option string)) (field "info-code" (option u16))))
  (type $tls-alert (record (field "alert-id" (option u8)) (field "alert-message" (option string))))
  (type $field-size (record (field "field-name" (option string)) (field "field-size" (option u32))))
  (type $error-code (variant
    (case "DNS-timeout")
    (case "DNS-error" $dns-error)
    (case "destination-not-found")
    (case "destination-unavailable")
    (case "destination-IP-prohibited")
    (case "destination-IP-unroutable")
    (case "connection-refused")
    (case "connection-terminated")
    (case "connection-timeout")
    (case "connection-read-timeout")
    (case "connection-write-timeout")
    (case "connection-limit-reached")
    (case "TLS-protocol-error")
    (case "TLS-certificate-error")
    (case "TLS-alert-received" $tls-alert)
    (case "HTTP-request-denied")
    (case "HTTP-request-length-required")
    (case "HTTP-request-body-size" (option u64))
    (case "HTTP-request-method-invalid")
    (case "HTTP-request-URI-invalid")
    (case "HTTP-request-URI-too-long")
    (case "HTTP-request-header-section-size" (option u32))
    (case "HTTP-request-header-size" (option $field-size))
    (case "HTTP-request-trailer-section-size" (option u32))
    (case "HTTP-request-trailer-size" $field-size)
    (case "HTTP-response-incomplete")
    (case "HTTP-response-header-section-size" (option u32))
    (case "HTTP-response-header-size" $field-size)
    (case "HTTP-response-body-size" (option u64))
    (case "HTTP-response-trailer-section-size" (option u32))
    (case "HTTP-response-trailer-size" $field-size)
    (case "HTTP-response-transfer-coding" (option string))
    (case "HTTP-response-content-coding" (option string))
    (case "HTTP-response-timeout")
    (case "HTTP-upgrade-failed")
    (case "HTTP-protocol-error")
    (case "loop-detected")
    (case "configuration-error")
    (case "internal-error" (option string))
  ))
  (type $message (record (field "subject" string) (field "body" (stream u8))
    (field "reply-to" (option string))))
  (type $disposition (variant (case "reject") (case "retry") (case "other" string)))
  (import "test:supervision/linked@0.1.0" (instance $linked
    (export "next" (func (result u32)))))
  (alias export $linked "next" (func $next))
  (core func $next (canon lower (func $next)))
  (import "test:supervision/probe@0.1.0" (instance $host
    (export "probe" (func async (param "service-count" u32) (param "linked-count" u32) (result u32)))))
  (alias export $host "probe" (func $probe))
  (core func $probe (canon lower (func $probe)))
  (core func $return (canon task.return (result (result))))
  (core func $reply (canon task.return (result u32)))
  (core module $m
    (import "host" "next" (func $next (result i32)))
    (import "host" "probe" (func $probe (param i32 i32) (result i32)))
    (import "host" "return" (func $return (param i32)))
    (import "host" "reply" (func $reply (param i32)))
    (memory (export "memory") 1)
    (global $count (mut i32) i32.const 0)
    (func (export "run") (result i32)
      global.get $count i32.const 1 i32.add global.set $count
      global.get $count call $next call $probe AFTER_PROBE call $return i32.const 0)
    (func (export "count") (result i32)
      global.get $count call $reply i32.const 0)
    (func (export "handle") (param i32) (result i32) unreachable)
    (func (export "handle-message") (param i32 i32 i32 i32 i32 i32) (result i32) unreachable)
    (func (export "realloc") (param i32 i32 i32 i32) (result i32) unreachable)
    (func (export "callback") (param i32 i32 i32) (result i32) unreachable))
  (core instance $m (instantiate $m (with "host" (instance
    (export "next" (func $next)) (export "probe" (func $probe))
    (export "return" (func $return)) (export "reply" (func $reply))))))
  (alias core export $m "memory" (core memory $memory))
  (alias core export $m "realloc" (core func $realloc))
  (func $run async (result (result)) (canon lift (core func $m "run")
    async (callback (core func $m "callback"))))
  (instance $cli (export "run" (func $run)))
  (export "wasi:cli/run@0.3.0" (instance $cli))
  (func $count async (result u32) (canon lift (core func $m "count")
    async (callback (core func $m "callback"))))
  (instance $api (export "count" (func $count)))
  (export "test:supervision/state@0.1.0" (instance $api))
  (func $http-handle async (param "request" (own $request))
    (result (result (own $response) (error $error-code)))
    (canon lift (core func $m "handle") async (memory $memory)
      (realloc $realloc) (callback (core func $m "callback"))))
  (instance $http
    (export "request" (type $request)) (export "response" (type $response))
    (export "dns-error-payload" (type $dns-error)) (export "tls-alert-received-payload" (type $tls-alert))
    (export "field-size-payload" (type $field-size)) (export "error-code" (type $error-code))
    (export "handle" (func $http-handle)))
  HTTP_EXPORT
  (func $message-handle async (param "msg" $message) (result (result (error $disposition)))
    (canon lift (core func $m "handle-message") async (memory $memory)
      (realloc $realloc) (callback (core func $m "callback"))))
  (instance $messaging
    (export "broker-message" (type $message)) (export "handle-message-error" (type $disposition))
    (export "handle-message" (func $message-handle)))
  MESSAGING_EXPORT)
