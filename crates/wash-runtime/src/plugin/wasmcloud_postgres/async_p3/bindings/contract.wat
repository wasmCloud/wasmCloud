;; Independent component type contract for wasmcloud:postgres@0.2.0.
(component
  (import "wasmcloud:postgres/types@0.2.0" (instance $types
    (type $internal-db-error (record (field "code" string) (field "severity" string) (field "message" string) (field "detail" (option string)) (field "extras" (list (tuple string string)))))
    (export "db-error" (type $db-error (eq $internal-db-error)))
    (type $internal-error (variant
    (case "connection-failed" string)
    (case "invalid-params" string)
    (case "invalid-query" string)
    (case "query-failed" $db-error)
    (case "value-conversion-failed" string)
    (case "unknown-prepared-statement")
    (case "access-denied")
    (case "timeout")
    (case "other" string)))
    (export "error" (type $error (eq $internal-error)))
    (type $internal-hashable-f64 (tuple u64 s16 s8))
    (export "hashable-f64" (type $hashable-f64 (eq $internal-hashable-f64)))
    (type $internal-point (tuple $hashable-f64 $hashable-f64))
    (export "point" (type $point (eq $internal-point)))
    (type $internal-ipv4-addr string)
    (export "ipv4-addr" (type $ipv4-addr (eq $internal-ipv4-addr)))
    (type $internal-ipv6-addr string)
    (export "ipv6-addr" (type $ipv6-addr (eq $internal-ipv6-addr)))
    (type $internal-subnet string)
    (export "subnet" (type $subnet (eq $internal-subnet)))
    (type $internal-xmin s64)
    (export "xmin" (type $xmin (eq $internal-xmin)))
    (type $internal-xmax s64)
    (export "xmax" (type $xmax (eq $internal-xmax)))
    (type $internal-xip-list (list s64))
    (export "xip-list" (type $xip-list (eq $internal-xip-list)))
    (type $internal-logfile-num u32)
    (export "logfile-num" (type $logfile-num (eq $internal-logfile-num)))
    (type $internal-logfile-byte-offset u32)
    (export "logfile-byte-offset" (type $logfile-byte-offset (eq $internal-logfile-byte-offset)))
    (type $internal-column-name string)
    (export "column-name" (type $column-name (eq $internal-column-name)))
    (type $internal-numeric string)
    (export "numeric" (type $numeric (eq $internal-numeric)))
    (type $internal-lexeme-weight (enum "A" "B" "C" "D"))
    (export "lexeme-weight" (type $lexeme-weight (eq $internal-lexeme-weight)))
    (type $internal-lexeme (record (field "position" (option u16)) (field "weight" (option $lexeme-weight)) (field "data" string)))
    (export "lexeme" (type $lexeme (eq $internal-lexeme)))
    (type $internal-offset (variant
    (case "eastern-hemisphere-secs" s32)
    (case "western-hemisphere-secs" s32)))
    (export "offset" (type $offset (eq $internal-offset)))
    (type $internal-date (variant
    (case "positive-infinity")
    (case "negative-infinity")
    (case "ymd" (tuple s32 u32 u32))))
    (export "date" (type $date (eq $internal-date)))
    (type $internal-interval (record (field "start" $date) (field "start-inclusive" bool) (field "end" $date) (field "end-inclusive" bool)))
    (export "interval" (type $interval (eq $internal-interval)))
    (type $internal-time (record (field "hour" u32) (field "min" u32) (field "sec" u32) (field "micro" u32)))
    (export "time" (type $time (eq $internal-time)))
    (type $internal-time-tz (record (field "timesonze" string) (field "time" $time)))
    (export "time-tz" (type $time-tz (eq $internal-time-tz)))
    (type $internal-timestamp (record (field "date" $date) (field "time" $time)))
    (export "timestamp" (type $timestamp (eq $internal-timestamp)))
    (type $internal-timestamp-tz (record (field "timestamp" $timestamp) (field "offset" $offset)))
    (export "timestamp-tz" (type $timestamp-tz (eq $internal-timestamp-tz)))
    (type $internal-mac-address-eui48 (record (field "bytes" (tuple u8 u8 u8 u8 u8 u8))))
    (export "mac-address-eui48" (type $mac-address-eui48 (eq $internal-mac-address-eui48)))
    (type $internal-mac-address-eui64 (record (field "bytes" (tuple u8 u8 u8 u8 u8 u8 u8 u8))))
    (export "mac-address-eui64" (type $mac-address-eui64 (eq $internal-mac-address-eui64)))
    (type $internal-pg-value (variant

    (case "null")
    (case "big-int" s64)
    (case "int8" s64)
    (case "int8-array" (list s64))
    (case "big-serial" s64)
    (case "serial8" s64)
    (case "bool" bool)
    (case "boolean" bool)
    (case "bool-array" (list bool))
    (case "double" $hashable-f64)
    (case "float8" $hashable-f64)
    (case "float8-array" (list $hashable-f64))
    (case "real" $hashable-f64)
    (case "float4" $hashable-f64)
    (case "float4-array" (list $hashable-f64))
    (case "integer" s32)
    (case "int" s32)
    (case "int4" s32)
    (case "int4-array" (list s32))
    (case "numeric" $numeric)
    (case "decimal" $numeric)
    (case "numeric-array" (list $numeric))
    (case "serial" u32)
    (case "serial4" u32)
    (case "small-int" s16)
    (case "int2" s16)
    (case "int2-array" (list s16))
    (case "int2-vector" (list s16))
    (case "int2-vector-array" (list (list s16)))
    (case "small-serial" s16)
    (case "serial2" s16)
    (case "bit" (tuple u32 (list u8)))
    (case "bit-array" (list (tuple u32 (list u8))))
    (case "bit-varying" (tuple (option u32) (list u8)))
    (case "varbit" (tuple (option u32) (list u8)))
    (case "varbit-array" (list (tuple (option u32) (list u8))))
    (case "bytea" (list u8))
    (case "bytea-array" (list (list u8)))
    (case "char" (tuple u32 (list u8)))
    (case "char-array" (list (tuple u32 (list u8))))
    (case "varchar" (tuple (option u32) (list u8)))
    (case "varchar-array" (list (tuple (option u32) (list u8))))
    (case "cidr" string)
    (case "cidr-array" (list string))
    (case "inet" string)
    (case "inet-array" (list string))
    (case "macaddr" $mac-address-eui48)
    (case "macaddr-array" (list $mac-address-eui48))
    (case "macaddr8" $mac-address-eui64)
    (case "macaddr8-array" (list $mac-address-eui64))
    (case "box" (tuple $point $point))
    (case "box-array" (list (tuple $point $point)))
    (case "circle" (tuple $point $hashable-f64))
    (case "circle-array" (list (tuple $point $hashable-f64)))
    (case "line" (tuple $point $point))
    (case "line-array" (list (tuple $point $point)))
    (case "lseg" (tuple $point $point))
    (case "lseg-array" (list (tuple $point $point)))
    (case "path" (list $point))
    (case "path-array" (list (list $point)))
    (case "point" $point)
    (case "point-array" (list $point))
    (case "polygon" (list $point))
    (case "polygon-array" (list (list $point)))
    (case "date" $date)
    (case "date-array" (list $date))
    (case "interval" $interval)
    (case "interval-array" (list $interval))
    (case "time" $time)
    (case "time-array" (list $time))
    (case "time-tz" $time-tz)
    (case "time-tz-array" (list $time-tz))
    (case "timestamp" $timestamp)
    (case "timestamp-array" (list $timestamp))
    (case "timestamp-tz" $timestamp-tz)
    (case "timestamp-tz-array" (list $timestamp-tz))
    (case "json" string)
    (case "json-array" (list string))
    (case "jsonb" string)
    (case "jsonb-array" (list string))
    (case "money" $numeric)
    (case "money-array" (list $numeric))
    (case "pg-lsn" u64)
    (case "pg-lsn-array" (list u64))
    (case "pg-snapshot" (tuple $xmin $xmax $xip-list))
    (case "txid-snapshot" s64)
    (case "name" string)
    (case "name-array" (list string))
    (case "text" string)
    (case "text-array" (list string))
    (case "xml" string)
    (case "xml-array" (list string))
    (case "ts-query" string)
    (case "ts-vector" (list $lexeme))
    (case "uuid" string)
    (case "uuid-array" (list string))
    (case "hstore" (list (tuple string (option string))))))
    (export "pg-value" (type $pg-value (eq $internal-pg-value)))
    (type $internal-row (list $pg-value))
    (export "row" (type $row (eq $internal-row)))
  ))
  (alias export $types "db-error" (type $db-error))
  (alias export $types "error" (type $error))
  (alias export $types "hashable-f64" (type $hashable-f64))
  (alias export $types "point" (type $point))
  (alias export $types "ipv4-addr" (type $ipv4-addr))
  (alias export $types "ipv6-addr" (type $ipv6-addr))
  (alias export $types "subnet" (type $subnet))
  (alias export $types "xmin" (type $xmin))
  (alias export $types "xmax" (type $xmax))
  (alias export $types "xip-list" (type $xip-list))
  (alias export $types "logfile-num" (type $logfile-num))
  (alias export $types "logfile-byte-offset" (type $logfile-byte-offset))
  (alias export $types "column-name" (type $column-name))
  (alias export $types "numeric" (type $numeric))
  (alias export $types "lexeme-weight" (type $lexeme-weight))
  (alias export $types "lexeme" (type $lexeme))
  (alias export $types "offset" (type $offset))
  (alias export $types "date" (type $date))
  (alias export $types "interval" (type $interval))
  (alias export $types "time" (type $time))
  (alias export $types "time-tz" (type $time-tz))
  (alias export $types "timestamp" (type $timestamp))
  (alias export $types "timestamp-tz" (type $timestamp-tz))
  (alias export $types "mac-address-eui48" (type $mac-address-eui48))
  (alias export $types "mac-address-eui64" (type $mac-address-eui64))
  (alias export $types "pg-value" (type $pg-value))
  (alias export $types "row" (type $row))
  ;; Padding keeps task.return indirect; the adapter forwards the result in memory.
  (type $padding (tuple u32 u32 u32 u32 u32 u32 u32 u32 u32 u32 u32 u32 u32 u32 u32 u32))
  (type $query-result (result (tuple (list string) (stream $row) (future (result (error $error)))) (error $error)))
  (import "wasmcloud:postgres/query@0.2.0" (instance $query
    (export "pg-value" (type (eq $pg-value)))
    (export "error" (type (eq $error)))
    (export "row" (type (eq $row)))
    (export "query" (func async (param "query" string) (param "params" (list $pg-value)) (result $query-result)))
    (export "query-batch" (func async (param "query" string) (result (result (error $error)))))
  ))
  (import "wasmcloud:postgres/prepared@0.2.0" (instance $prepared
    (export "pg-value" (type (eq $pg-value)))
    (export "error" (type (eq $error)))
    (export "prepare" (func async (param "statement" string) (result (result string (error $error)))))
    (export "exec" (func async (param "stmt-token" string) (param "params" (list $pg-value)) (result (result u64 (error $error)))))
  ))
  (core module $memory-module
    (memory (export "memory") 1)
    (global $heap (mut i32) (i32.const 1024))
    (func (export "realloc") (param i32 i32) (param $align i32) (param $size i32) (result i32)
      (local $ptr i32)
      global.get $heap
      local.get $align i32.const 1 i32.sub i32.add
      i32.const 0 local.get $align i32.sub i32.and
      local.tee $ptr local.get $size i32.add global.set $heap
      global.get $heap memory.size i32.const 16 i32.shl i32.gt_u
      if
        global.get $heap i32.const 65535 i32.add i32.const 16 i32.shr_u
        memory.size i32.sub memory.grow drop
      end
      local.get $ptr))
  (core instance $memory (instantiate $memory-module))
  (core func $query (canon lower (func $query "query") (memory (core memory $memory "memory")) (realloc (core func $memory "realloc"))))
  (core func $batch (canon lower (func $query "query-batch") (memory (core memory $memory "memory")) (realloc (core func $memory "realloc"))))
  (core func $prepare (canon lower (func $prepared "prepare") (memory (core memory $memory "memory")) (realloc (core func $memory "realloc"))))
  (core func $exec (canon lower (func $prepared "exec") (memory (core memory $memory "memory")) (realloc (core func $memory "realloc"))))
  (core func $query-return (canon task.return (result (tuple $query-result $padding)) (memory (core memory $memory "memory"))))
  (core func $batch-return (canon task.return (result (tuple (result (error $error)) $padding)) (memory (core memory $memory "memory"))))
  (core func $prepare-return (canon task.return (result (tuple (result string (error $error)) $padding)) (memory (core memory $memory "memory"))))
  (core func $exec-return (canon task.return (result (tuple (result u64 (error $error)) $padding)) (memory (core memory $memory "memory"))))
  (core module $forward
    (import "host" "memory" (memory 1))
    (import "host" "query" (func $query (param i32 i32 i32 i32 i32)))
    (import "host" "batch" (func $batch (param i32 i32 i32)))
    (import "host" "prepare" (func $prepare (param i32 i32 i32)))
    (import "host" "exec" (func $exec (param i32 i32 i32 i32 i32)))
    (import "host" "query-return" (func $query-return (param i32)))
    (import "host" "batch-return" (func $batch-return (param i32)))
    (import "host" "prepare-return" (func $prepare-return (param i32)))
    (import "host" "exec-return" (func $exec-return (param i32)))
    (func $clear i32.const 0 i32.const 0 i32.const 128 memory.fill)
    (func (export "query") (param i32 i32 i32 i32)
      call $clear
      local.get 0 local.get 1 local.get 2 local.get 3 i32.const 0 call $query
      i32.const 0 call $query-return)
    (func (export "batch") (param i32 i32)
      call $clear
      local.get 0 local.get 1 i32.const 0 call $batch
      i32.const 0 call $batch-return)
    (func (export "prepare") (param i32 i32)
      call $clear
      local.get 0 local.get 1 i32.const 0 call $prepare
      i32.const 0 call $prepare-return)
    (func (export "exec") (param i32 i32 i32 i32)
      call $clear
      local.get 0 local.get 1 local.get 2 local.get 3 i32.const 0 call $exec
      i32.const 0 call $exec-return))
  (core instance $forward (instantiate $forward
    (with "host" (instance
      (export "memory" (memory $memory "memory"))
      (export "query" (func $query)) (export "batch" (func $batch))
      (export "prepare" (func $prepare)) (export "exec" (func $exec))
      (export "query-return" (func $query-return)) (export "batch-return" (func $batch-return))
      (export "prepare-return" (func $prepare-return)) (export "exec-return" (func $exec-return))))))
  (func (export "query") async (param "query" string) (param "params" (list $pg-value)) (result (tuple $query-result $padding))
    (canon lift (core func $forward "query") async (memory (core memory $memory "memory")) (realloc (core func $memory "realloc"))))
  (func (export "query-batch") async (param "query" string) (result (tuple (result (error $error)) $padding))
    (canon lift (core func $forward "batch") async (memory (core memory $memory "memory")) (realloc (core func $memory "realloc"))))
  (func (export "prepare") async (param "statement" string) (result (tuple (result string (error $error)) $padding))
    (canon lift (core func $forward "prepare") async (memory (core memory $memory "memory")) (realloc (core func $memory "realloc"))))
  (func (export "exec") async (param "stmt-token" string) (param "params" (list $pg-value)) (result (tuple (result u64 (error $error)) $padding))
    (canon lift (core func $forward "exec") async (memory (core memory $memory "memory")) (realloc (core func $memory "realloc"))))
)
