package wasmcloud:runtime@0.1.0;

world http-server {
    import wasi:http/types@0.2.0;
    export wasi:http/incoming-handler@0.2.0;
}

world config {
    import wasi:config/store@0.2.0-rc.1;
}

world secrets {
    import wasmcloud:secrets/store@2.1.0;
    import wasmcloud:secrets/reveal@2.1.0;
    import wasmcloud:secrets/secret@2.1.0;
}

world logging {
    import wasi:logging/logging@0.1.0-draft;
}

world keyvalue {
    import wasi:keyvalue/atomics@0.2.0-draft;
    import wasi:keyvalue/batch@0.2.0-draft;
    import wasi:keyvalue/store@0.2.0-draft;
}

world blobstore {
    import wasi:blobstore/types@0.2.0-draft;
    import wasi:blobstore/container@0.2.0-draft;
    import wasi:blobstore/blobstore@0.2.0-draft;
}

world messaging {
    import wasmcloud:messaging/types@0.2.0;
    import wasmcloud:messaging/consumer@0.2.0;
    export wasmcloud:messaging/handler@0.2.0;
}

world postgres {
  import wasmcloud:postgres/types@0.1.1-draft;
  import wasmcloud:postgres/query@0.1.1-draft;
  import wasmcloud:postgres/prepared@0.1.1-draft;
}

world async-blobstore {
  import wasmcloud:blobstore/types@0.1.0;
  import wasmcloud:blobstore/container@0.1.0;
  import wasmcloud:blobstore/blobstore@0.1.0;
}

world async-keyvalue {
  import wasmcloud:keyvalue/types@0.2.0;
  import wasmcloud:keyvalue/store@0.2.0;
  import wasmcloud:keyvalue/atomics@0.2.0;
  import wasmcloud:keyvalue/cas@0.2.0;
  import wasmcloud:keyvalue/batch@0.2.0;
}

world async-postgres {
  import wasmcloud:postgres/types@0.2.0;
  import wasmcloud:postgres/query@0.2.0;
  import wasmcloud:postgres/prepared@0.2.0;
}

world async-messaging {
  import wasmcloud:messaging/types@0.3.0;
  import wasmcloud:messaging/consumer@0.3.0;
  export wasmcloud:messaging/handler@0.3.0;
}


// Host-side bindgen input: every import the plugin serves, in one world so the
// linker is populated from a single generated module. Not a world components
// target; those are the role-shaped ones below.
world nats-imports {
    import wasmcloud:nats/types@0.1.0;
    import wasmcloud:nats/core@0.1.0;
    import wasmcloud:nats/jetstream@0.1.0;
    import wasmcloud:nats/kv@0.1.0;
}

// A workload that publishes, or does request/reply. No subscriptions.
world nats-publisher {
    import wasmcloud:nats/types@0.1.0;
    import wasmcloud:nats/core@0.1.0;
}

// A workload the host pushes core NATS messages into.
world nats-subscriber {
    import wasmcloud:nats/types@0.1.0;
    export wasmcloud:nats/core-handler@0.1.0;
}

// A workload that publishes into JetStream.
world nats-js-publisher {
    import wasmcloud:nats/types@0.1.0;
    import wasmcloud:nats/jetstream@0.1.0;
}

// A workload the host pushes JetStream deliveries into. Per-request: it holds
// no consumer and no stream, so it scales down between bursts.
world nats-js-processor {
    import wasmcloud:nats/types@0.1.0;
    import wasmcloud:nats/jetstream@0.1.0;
    export wasmcloud:nats/jetstream-handler@0.1.0;
}

// A workload that reads and writes KV directly.
world nats-kv-client {
    import wasmcloud:nats/types@0.1.0;
    import wasmcloud:nats/kv@0.1.0;
}

// A workload the host pushes KV change events into.
world nats-kv-watcher {
    import wasmcloud:nats/types@0.1.0;
    import wasmcloud:nats/kv@0.1.0;
    export wasmcloud:nats/kv-handler@0.1.0;
}

world otel {
    import wasi:otel/types@0.2.0-rc.2;
    import wasi:otel/tracing@0.2.0-rc.2;
    import wasi:otel/metrics@0.2.0-rc.2;
    import wasi:otel/logs@0.2.0-rc.2;
}
