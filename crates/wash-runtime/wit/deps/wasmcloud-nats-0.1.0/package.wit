package wasmcloud:nats@0.2.0;

/// Shared types and errors used across the wasmcloud:nats interfaces.
///
/// Unlike `wasmcloud:nats@0.1.0`, every operation in this package is an
/// `async func`. A component built for WASI P3 can keep many publishes,
/// requests, and JetStream fetches in flight at once, and a handler can await
/// other imports while the host continues delivering to the same instance.
/// The sync `@0.1.0` package remains available for P2 components.
interface types {
  /// A NATS message. Applies to both core and JetStream messages.
  record nats-message {
    subject: string,
    body: list<u8>,
    reply-to: option<string>,
    headers: option<list<header-entry>>,
  }

  /// A single header key-value pair.
  ///
  /// Names must be printable ASCII without `:`; values may not contain CR or
  /// LF. Anything else is refused with `invalid-header` rather than reaching
  /// the wire.
  record header-entry {
    name: string,
    value: string,
  }

  /// Why the host refused a name.
  enum denial-reason {
    /// The name is in a space the host reserves for itself — the JetStream
    /// API, the KV/object-store key spaces, `$SYS`, or the host's own lattice.
    reserved,
    /// No grant on this binding covers the name.
    not-granted,
    /// A publish or request subject contained `*` or `>`.
    wildcard-not-allowed,
  }

  /// What kind of name was refused, and so which grant to widen:
  /// `subject-allow`, `stream-allow`, or `bucket-allow`. `subject-denied` in
  /// `@0.1.0` carried all three in one string.
  ///
  /// Subscription patterns are not here: they are checked once at bind time,
  /// where a refusal fails the deployment rather than reaching a guest.
  enum denied-resource {
    /// A publish or request subject.
    subject,
    /// A JetStream stream name.
    %stream,
    /// A KV bucket name.
    bucket,
  }

  /// A refusal by the host's grant check.
  record denial {
    reason: denial-reason,
    target: denied-resource,
    /// The name that was refused.
    name: string,
  }

  /// Typed errors for NATS operations.
  variant nats-error {
    /// Connection / transport error talking to NATS.
    connection(string),
    /// Request timed out.
    timeout(string),
    /// No subscriber is listening on the subject. Distinct from `timeout`:
    /// retrying immediately will fail the same way until a responder appears.
    no-responders,
    /// The name is outside the grant this workload was bound with, or in a
    /// space the host reserves. Replaces `@0.1.0`'s `subject-denied(string)`.
    denied(denial),
    /// The payload exceeds the server's advertised `max_payload`. The value
    /// is that limit, in bytes. Header bytes count toward it.
    max-payload-exceeded(u64),
    /// A header name or value is not representable on the NATS wire.
    invalid-header(string),
    /// JetStream-specific error with a detail string.
    jetstream(string),
    /// The key was not found in a KV bucket.
    key-not-found,
    /// CAS `update` failed. Payload carries the actual current revision, so a
    /// retry does not need a re-read.
    revision-mismatch(u64),
    /// A pull-consumer `fetch` returned empty within the timeout: the
    /// consumer had nothing to give. Compare `limit-exceeded`, where the
    /// request never ran.
    no-messages,
    /// The server refused the request outright because it exceeds a limit the
    /// consumer was provisioned with — a batch over `max-request-batch`, a
    /// byte bound over `max-request-max-bytes`, or too many waiting pulls.
    /// Nothing was delivered, and retrying unchanged fails the same way;
    /// `info` reports the limits to size the next request against.
    limit-exceeded(string),
    /// Named resource (stream, bucket, consumer) doesn't exist.
    not-found(string),
    /// The connected server is too old for this operation. The string names
    /// the minimum version required.
    unsupported-by-server(string),
    /// No live connection is bound to this workload. Distinct from
    /// `connection`, which is a transport error on a live connection.
    disconnected,
    /// Anything that doesn't fit the cases above.
    unexpected(string),
  }
}

/// Core NATS: fire-and-forget publish and request/reply. No durability.
///
/// Every subject is checked against the workload's grant before it reaches the
/// server. A subject outside the grant returns `denied` and never leaves the
/// host.
interface core {
  use types.{nats-message, nats-error};

  /// Publish a message. Fire-and-forget: this resolves once the message is
  /// written to the connection, not once any subscriber has seen it.
  publish: async func(msg: nats-message) -> result<_, nats-error>;

  /// Send a request and wait for a single reply within timeout.
  ///
  /// Because this is an `async func`, a component may have many requests
  /// outstanding at once; awaiting one does not block the instance.
  ///
  /// Replies arrive on a per-workload inbox prefix, so two workloads sharing a
  /// host cannot observe each other's responses. The `reply-to` field of `msg`
  /// is ignored: the host always substitutes the per-workload inbox as the
  /// reply subject.
  request: async func(msg: nats-message, timeout-ms: u32) -> result<nats-message, nats-error>;
}

/// JetStream: durable publish, pull-consumer attach, message retrieval, and
/// read-only stream/consumer introspection.
///
/// Stream / consumer *lifecycle* (create, update, delete) is intentionally
/// absent rather than exported-and-denied: provision streams and consumers
/// out-of-band via deployment tooling or the NATS CLI. Introspection is served
/// because a workload legitimately needs to know the shape of what it was
/// granted.
///
/// ## Delivery semantics
///
/// Explicit ack policy means redelivery on trap or ack-wait expiry. This is
/// at-least-once: handlers must be idempotent. Returning without acking is not
/// an error, but it stalls the consumer for the full `ack-wait` before the
/// message is redelivered.
interface jetstream {
  use types.{nats-message, nats-error, header-entry};

  /// Ack returned from a JetStream publish.
  record publish-ack {
    stream-name: string,
    sequence: u64,
    /// True when the server recognised this message as a duplicate within the
    /// stream's duplicate window and did not store it again.
    duplicate: bool,
  }

  /// A message retrieved from a JetStream stream (read-only snapshot).
  record stored-message {
    subject: string,
    sequence: u64,
    data: list<u8>,
    headers: option<list<header-entry>>,
  }

  /// One subject a stream currently holds messages on, with its message count.
  record subject-count {
    subject: string,
    count: u64,
  }

  /// Read-only snapshot of a stream.
  record stream-info {
    name: string,
    /// Subjects the stream is configured to capture.
    subjects: list<string>,
    messages: u64,
    bytes: u64,
    first-sequence: u64,
    last-sequence: u64,
    consumer-count: u64,
  }

  /// Read-only snapshot of a consumer, including the limits it was
  /// provisioned with.
  record consumer-info {
    name: string,
    stream-name: string,
    /// Singular filter; empty when unset. Consumers may instead use
    /// `filter-subjects`; the consumer captures the stream's whole subject
    /// space only when both are empty.
    filter-subject: string,
    /// Multi-subject filter, as provisioned on servers 2.10 and newer. Empty
    /// when the consumer uses the singular `filter-subject`, or no filter at
    /// all.
    filter-subjects: list<string>,
    /// Zero when unset on the consumer.
    max-ack-pending: u64,
    /// Zero when unset. Pull consumers only.
    max-waiting: u64,
    /// Largest `batch` a single pull may ask for. Zero when unset. A `fetch`
    /// above it is refused with `limit-exceeded`, not truncated.
    max-request-batch: u64,
    /// Largest byte bound a single pull may ask for. Zero when unset. Counts
    /// subject, reply subject, and payload — roughly 63 bytes of overhead per
    /// small message — so leave margin when sizing against it.
    max-request-max-bytes: u64,
    /// Zero when unset.
    max-deliver: u64,
    ack-wait-ms: u64,
    /// Messages delivered but not yet acknowledged.
    num-ack-pending: u64,
    /// Messages waiting to be delivered.
    num-pending: u64,
    /// Messages awaiting redelivery after a nak or ack-wait expiry.
    num-redelivered: u64,
  }

  /// Why a fetch stopped delivering.
  enum fetch-stop {
    /// The batch was filled: `batch` messages came back.
    batch-filled,
    /// The consumer had no more to give before the timeout elapsed. What came
    /// back is everything that was there.
    drained,
    /// A byte bound ended the batch early — `max-bytes` on the call, or the
    /// consumer's `max-request-max-bytes`. More messages are waiting, and the
    /// next fetch picks up where this one stopped.
    byte-limit,
  }

  /// A fetched batch, and why it ended.
  record fetched-batch {
    messages: list<message-handle>,
    stop: fetch-stop,
  }

  /// Handle to a single JetStream-delivered message.
  ///
  /// Acknowledgement methods consume the handle's internal state — calling
  /// ack/nak/term more than once returns an error. `in-progress` can be called
  /// repeatedly to extend ack-wait.
  resource message-handle {
    /// Borrow the underlying message.
    message: func() -> nats-message;
    /// Stream sequence number.
    sequence: func() -> u64;
    /// Number of times this message has been delivered (1 on first delivery).
    delivery-count: func() -> u32;

    /// Acknowledge successful processing. Fire-and-forget: it resolves once
    /// the ack is written, not once the server has recorded it.
    ack: async func() -> result<_, nats-error>;
    /// Acknowledge and wait for the server to confirm it (double-ack).
    ///
    /// Slower than `ack` by one round trip, and the only way to know a
    /// delivery will not be repeated after a server or client failure.
    ack-sync: async func() -> result<_, nats-error>;
    /// Negative-acknowledge with an optional redelivery delay.
    nak: async func(delay-ms: option<u32>) -> result<_, nats-error>;
    /// Reset the ack-wait timer while work is still in progress.
    in-progress: async func() -> result<_, nats-error>;
    /// Reject the message permanently — do not redeliver.
    term: async func() -> result<_, nats-error>;
  }

  /// Pull-based consumer for batched, backpressure-friendly reads. The
  /// consumer must already exist on the stream — attach via `open-pull-consumer`.
  resource pull-consumer {
    /// Fetch up to `batch` messages, waiting at most `timeout-ms` for the
    /// first message. Returns `no-messages` if the timeout elapses empty, and
    /// `limit-exceeded` if `batch` is over the consumer's `max-request-batch`.
    ///
    /// `batch` must be >= 1; a `batch` of 0 is refused with `unexpected`
    /// rather than reported as a drained consumer.
    fetch: async func(batch: u32, timeout-ms: u32) -> result<fetched-batch, nats-error>;
    /// Fetch bounded by bytes as well as count, for consumers provisioned
    /// with a `max-bytes` limit. `max-bytes` of 0 means no byte bound, and
    /// `batch` must be >= 1 as it must for `fetch`.
    ///
    /// A batch cut short by either byte bound comes back with `stop:
    /// byte-limit` rather than looking like a drained consumer.
    fetch-with-limits: async func(batch: u32, max-bytes: u64, timeout-ms: u32) -> result<fetched-batch, nats-error>;
    /// The consumer's current configuration and state.
    info: async func() -> result<consumer-info, nats-error>;
  }

  /// Publish a message to a JetStream-managed subject.
  ///
  /// Idempotency is available via the `Nats-Msg-Id` header, deduplicated within
  /// the stream's duplicate window. That window is stream configuration, not a
  /// guarantee this interface makes.
  ///
  /// The `reply-to` field of `msg` is ignored: JetStream acknowledgments use a
  /// client-managed reply subject.
  publish: async func(msg: nats-message) -> result<publish-ack, nats-error>;

  /// Fetch a single message by its stream sequence number (direct-get).
  get-by-sequence: async func(stream-name: string, sequence: u64) -> result<stored-message, nats-error>;

  /// Sequential replay: read up to `max-count` messages starting from
  /// `start-sequence`. Stateless — does not create a durable consumer.
  ///
  /// Only messages whose stored subject falls inside the workload's subject
  /// grant are returned, so the sequence numbers of a batch may gap. A skipped
  /// message does not count against `max-count`: the result is what a
  /// server-side filtered consumer would have delivered.
  scan: async func(stream-name: string, start-sequence: u64, max-count: u32) -> result<list<stored-message>, nats-error>;

  /// Attach to an existing pull consumer on a stream. The consumer must have
  /// been provisioned out-of-band (e.g. via the NATS CLI).
  open-pull-consumer: async func(stream-name: string, consumer: string) -> result<pull-consumer, nats-error>;

  /// Read-only stream configuration and state.
  get-stream-info: async func(stream-name: string) -> result<stream-info, nats-error>;

  /// The subjects a stream currently holds messages on, filtered by
  /// `subject-filter` (`>` for all), with per-subject message counts.
  ///
  /// Returns at most 1000 subjects: subject cardinality, not message count,
  /// bounds what the host has to buffer, so pass a narrower `subject-filter`
  /// to page through a stream that holds more than that.
  ///
  /// Requires NATS server 2.7.2 or newer — older servers ignore the filter and
  /// answer with no subject map at all, so they report `unsupported-by-server`
  /// rather than an empty list.
  list-stream-subjects: async func(stream-name: string, subject-filter: string) -> result<list<subject-count>, nats-error>;

  /// Read-only consumer configuration and state, without attaching.
  get-consumer-info: async func(stream-name: string, consumer: string) -> result<consumer-info, nats-error>;
}

/// JetStream key-value store.
///
/// Bucket lifecycle (create/delete/list) is intentionally absent for the same
/// reason as stream administration — provision buckets out-of-band.
interface kv {
  use types.{nats-error};

  /// Operation that produced a KV entry.
  enum kv-operation {
    put,
    delete,
    purge,
  }

  /// A single entry as seen in get/history/watch.
  record entry {
    key: string,
    value: list<u8>,
    revision: u64,
    created-at-unix-nanos: u64,
    operation: kv-operation,
  }

  /// One page of a bucket's key listing.
  record key-page {
    keys: list<string>,
    /// True when the bucket holds more keys than this page carries. The
    /// listing is capped host-side, so a large bucket cannot be enumerated in
    /// full through this call.
    truncated: bool,
  }

  /// Status snapshot for a bucket.
  record bucket-status {
    bucket: string,
    /// Stored messages in the bucket's stream — live values plus retained
    /// history, matching what `nats kv status` reports as `Values`.
    values: u64,
    /// Revisions retained per key.
    history: u8,
    ttl-seconds: u64,
    bytes: u64,
  }

  /// Handle to an open KV bucket.
  resource bucket {
    /// Fetch the latest entry for a key. `key-not-found` when the key is
    /// absent, deleted, or purged — `@0.1.0` returned `option<entry>` and so
    /// never produced that variant.
    get: async func(key: string) -> result<entry, nats-error>;
    /// Put a value. Last-write-wins. Returns the new revision.
    put: async func(key: string, value: list<u8>) -> result<u64, nats-error>;
    /// Create a key only if absent. Returns the new revision.
    create: async func(key: string, value: list<u8>) -> result<u64, nats-error>;
    /// Compare-and-swap on revision. Fails with `revision-mismatch` on
    /// conflict, carrying the current revision so a retry needs no re-read.
    update: async func(key: string, value: list<u8>, expected-revision: u64) -> result<u64, nats-error>;
    /// Delete a key (tombstone, keeps history).
    delete: async func(key: string) -> result<_, nats-error>;
    /// Purge a key (removes history as well).
    purge: async func(key: string) -> result<_, nats-error>;

    /// Lists keys in the bucket, up to a host-imposed cap of 1000.
    ///
    /// `truncated` is what tells a guest the bucket holds more than the page
    /// carries — `@0.1.0` returned a bare list, where a partial answer was
    /// indistinguishable from a complete one and the tail was unreachable on
    /// retry.
    keys: async func() -> result<key-page, nats-error>;
    /// All historical entries for a key (put/update/delete/purge ops).
    /// `key-not-found` when the key has no history at all.
    history: async func(key: string) -> result<list<entry>, nats-error>;

    /// Bucket state snapshot, read fresh from the server.
    status: async func() -> result<bucket-status, nats-error>;
  }

  /// Open an existing bucket. Errors with `not-found` if it doesn't exist, or
  /// `denied` if the bucket is outside this workload's grant.
  open: async func(bucket: string) -> result<bucket, nats-error>;
}

/// Handler for JetStream deliveries.
///
/// The component acknowledges via the handle. Which side acks is per-binding
/// configuration: under `ack-mode: auto` the host acks on `ok` and naks on
/// `error` or trap, and under `ack-mode: manual` the host acks nothing and the
/// handle is the only path.
///
/// As an `async func` the handler may await imports — a KV read, a downstream
/// request — while the host keeps delivering further messages concurrently.
interface jetstream-handler {
  use jetstream.{message-handle};

  handle-message: async func(handle: message-handle) -> result<_, string>;
}

/// Handler for core NATS subscriptions. No ack semantics.
interface core-handler {
  use types.{nats-message};

  handle-message: async func(msg: nats-message) -> result<_, string>;
}

/// Handler for KV watch events.
interface kv-handler {
  use kv.{entry};

  handle-event: async func(bucket: string, entry: entry) -> result<_, string>;
}
