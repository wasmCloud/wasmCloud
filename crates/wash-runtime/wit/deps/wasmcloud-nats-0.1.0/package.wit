package wasmcloud:nats@0.1.0;

/// Shared types and errors used across the wasmcloud:nats interfaces.
@since(version = 0.1.0)
interface types {
  /// A NATS message. Applies to both core and JetStream messages.
  @since(version = 0.1.0)
  record nats-message {
    subject: string,
    body: list<u8>,
    reply-to: option<string>,
    headers: option<list<header-entry>>,
  }

  /// A single header key-value pair.
  @since(version = 0.1.0)
  record header-entry {
    name: string,
    value: string,
  }

  /// Typed errors for NATS operations.
  @since(version = 0.1.0)
  variant nats-error {
    /// Connection / transport error talking to NATS.
    connection(string),
    /// Request timed out.
    timeout(string),
    /// No subscriber is listening on the subject. Distinct from `timeout`:
    /// retrying immediately will fail the same way until a responder appears.
    no-responders,
    /// The subject is outside the grant this workload was bound with. The
    /// string is the subject that was refused.
    subject-denied(string),
    /// The payload exceeds the server's advertised `max_payload`. The value
    /// is that limit, in bytes.
    max-payload-exceeded(u64),
    /// JetStream-specific error with a detail string.
    jetstream(string),
    /// The key was not found in a KV bucket.
    key-not-found,
    /// CAS `update` failed. Payload carries the actual current revision, so a
    /// retry does not need a re-read.
    revision-mismatch(u64),
    /// A pull-consumer `fetch` returned empty within the timeout.
    no-messages,
    /// Named resource (stream, bucket, consumer) doesn't exist.
    not-found(string),
    /// The connected server is too old for this operation. The string names
    /// the minimum version required.
    unsupported-by-server(string),
    /// The connection is down. Distinct from `connection`, which is a
    /// transport error on a live connection.
    disconnected,
    /// Anything that doesn't fit the cases above.
    unexpected(string),
  }
}

/// Core NATS: fire-and-forget publish and request/reply. No durability.
///
/// Every subject is checked against the workload's grant before it reaches the
/// server. A subject outside the grant returns `subject-denied` and never
/// leaves the host.
@since(version = 0.1.0)
interface core {
  @since(version = 0.1.0)
  use types.{nats-message, nats-error};

  /// Publish a message. Fire-and-forget: this returns once the message is
  /// written to the connection, not once any subscriber has seen it.
  @since(version = 0.1.0)
  publish: func(msg: nats-message) -> result<_, nats-error>;

  /// Send a request and wait for a single reply within timeout.
  ///
  /// Replies arrive on a per-workload inbox prefix, so two workloads sharing a
  /// host cannot observe each other's responses. The `reply-to` field of `msg`
  /// is ignored: the host always substitutes the per-workload inbox as the
  /// reply subject.
  @since(version = 0.1.0)
  request: func(msg: nats-message, timeout-ms: u32) -> result<nats-message, nats-error>;
}

/// JetStream: durable publish, pull-consumer attach, and message retrieval.
///
/// Stream / consumer lifecycle (admin) is intentionally absent rather than
/// exported-and-denied: provision streams out-of-band via deployment tooling or
/// the NATS CLI. A workload can see this interface does not serve
/// administration, instead of discovering it at runtime one failed call at a
/// time.
///
/// ## Delivery semantics
///
/// Explicit ack policy means redelivery on trap or ack-wait expiry. This is
/// at-least-once: handlers must be idempotent. Returning without acking is not
/// an error, but it stalls the consumer for the full `ack-wait` before the
/// message is redelivered.
@since(version = 0.1.0)
interface jetstream {
  @since(version = 0.1.0)
  use types.{nats-message, nats-error, header-entry};

  /// Ack returned from a JetStream publish.
  @since(version = 0.1.0)
  record publish-ack {
    stream-name: string,
    sequence: u64,
    /// True when the server recognised this message as a duplicate within the
    /// stream's duplicate window and did not store it again.
    duplicate: bool,
  }

  /// A message retrieved from a JetStream stream (read-only snapshot).
  @since(version = 0.1.0)
  record stored-message {
    subject: string,
    sequence: u64,
    data: list<u8>,
    headers: option<list<header-entry>>,
  }

  /// Handle to a single JetStream-delivered message.
  ///
  /// Acknowledgement methods consume the handle's internal state — calling
  /// ack/nak/term more than once returns an error. `in-progress` can be called
  /// repeatedly to extend ack-wait.
  @since(version = 0.1.0)
  resource message-handle {
    /// Borrow the underlying message.
    @since(version = 0.1.0)
    message: func() -> nats-message;
    /// Stream sequence number.
    @since(version = 0.1.0)
    sequence: func() -> u64;
    /// Number of times this message has been delivered (1 on first delivery).
    @since(version = 0.1.0)
    delivery-count: func() -> u32;

    /// Acknowledge successful processing.
    @since(version = 0.1.0)
    ack: func() -> result<_, nats-error>;
    /// Negative-acknowledge with an optional redelivery delay.
    @since(version = 0.1.0)
    nak: func(delay-ms: option<u32>) -> result<_, nats-error>;
    /// Reset the ack-wait timer while work is still in progress.
    @since(version = 0.1.0)
    in-progress: func() -> result<_, nats-error>;
    /// Reject the message permanently — do not redeliver.
    @since(version = 0.1.0)
    term: func() -> result<_, nats-error>;
  }

  /// Pull-based consumer for batched, backpressure-friendly reads. The
  /// consumer must already exist on the stream — attach via `open-pull-consumer`.
  @since(version = 0.1.0)
  resource pull-consumer {
    /// Fetch up to `batch` messages, waiting at most `timeout-ms` for the
    /// first message. Returns `no-messages` if the timeout elapses empty.
    @since(version = 0.1.0)
    fetch: func(batch: u32, timeout-ms: u32) -> result<list<message-handle>, nats-error>;
  }

  /// Publish a message to a JetStream-managed subject.
  ///
  /// Idempotency is available via the `Nats-Msg-Id` header, deduplicated within
  /// the stream's duplicate window. That window is stream configuration, not a
  /// guarantee this interface makes.
  ///
  /// The `reply-to` field of `msg` is ignored: JetStream acknowledgments use a
  /// client-managed reply subject.
  @since(version = 0.1.0)
  publish: func(msg: nats-message) -> result<publish-ack, nats-error>;

  /// Fetch a single message by its stream sequence number (direct-get).
  @since(version = 0.1.0)
  get-by-sequence: func(stream-name: string, sequence: u64) -> result<stored-message, nats-error>;

  /// Sequential replay: read up to `max-count` messages starting from
  /// `start-sequence`. Stateless — does not create a durable consumer.
  ///
  /// Only messages whose stored subject falls inside the workload's subject
  /// grant are returned, so the sequence numbers of a batch may gap. A skipped
  /// message does not count against `max-count`: the result is what a
  /// server-side filtered consumer would have delivered.
  @since(version = 0.1.0)
  scan: func(stream-name: string, start-sequence: u64, max-count: u32) -> result<list<stored-message>, nats-error>;

  /// Attach to an existing pull consumer on a stream. The consumer must have
  /// been provisioned out-of-band (e.g. via the NATS CLI).
  @since(version = 0.1.0)
  open-pull-consumer: func(stream-name: string, consumer: string) -> result<pull-consumer, nats-error>;
}

/// JetStream key-value store.
///
/// Bucket lifecycle (create/delete/list) is intentionally absent for the same
/// reason as stream administration — provision buckets out-of-band.
@since(version = 0.1.0)
interface kv {
  @since(version = 0.1.0)
  use types.{nats-error};

  /// Operation that produced a KV entry.
  @since(version = 0.1.0)
  enum kv-operation {
    put,
    delete,
    purge,
  }

  /// A single entry as seen in get/history/watch.
  @since(version = 0.1.0)
  record entry {
    key: string,
    value: list<u8>,
    revision: u64,
    created-at-unix-nanos: u64,
    operation: kv-operation,
  }

  /// Status snapshot for a bucket.
  @since(version = 0.1.0)
  record bucket-status {
    bucket: string,
    values: u64,
    history: u8,
    ttl-seconds: u64,
    bytes: u64,
  }

  /// Handle to an open KV bucket.
  @since(version = 0.1.0)
  resource bucket {
    /// Fetch the latest entry for a key.
    @since(version = 0.1.0)
    get: func(key: string) -> result<option<entry>, nats-error>;
    /// Put a value. Last-write-wins. Returns the new revision.
    @since(version = 0.1.0)
    put: func(key: string, value: list<u8>) -> result<u64, nats-error>;
    /// Create a key only if absent. Returns the new revision.
    @since(version = 0.1.0)
    create: func(key: string, value: list<u8>) -> result<u64, nats-error>;
    /// Compare-and-swap on revision. Fails with `revision-mismatch` on
    /// conflict, carrying the current revision so a retry needs no re-read.
    @since(version = 0.1.0)
    update: func(key: string, value: list<u8>, expected-revision: u64) -> result<u64, nats-error>;
    /// Delete a key (tombstone, keeps history).
    @since(version = 0.1.0)
    delete: func(key: string) -> result<_, nats-error>;
    /// Purge a key (removes history as well).
    @since(version = 0.1.0)
    purge: func(key: string) -> result<_, nats-error>;

    /// Lists keys in the bucket, up to a host-imposed cap of 1000. A bucket
    /// holding more is truncated to that many with only a host-side warning:
    /// this revision has no way to tell the guest the answer is partial.
    @since(version = 0.1.0)
    keys: func() -> result<list<string>, nats-error>;
    /// All historical entries for a key (put/update/delete/purge ops).
    @since(version = 0.1.0)
    history: func(key: string) -> result<list<entry>, nats-error>;

    /// Bucket state snapshot.
    @since(version = 0.1.0)
    status: func() -> result<bucket-status, nats-error>;
  }

  /// Open an existing bucket. Errors with `not-found` if it doesn't exist, or
  /// `subject-denied` if the bucket is outside this workload's grant.
  @since(version = 0.1.0)
  open: func(bucket: string) -> result<bucket, nats-error>;
}

/// Handler for JetStream deliveries.
///
/// The component acknowledges via the handle. Which side acks is per-binding
/// configuration: under `ack-mode: auto` the host acks on `ok` and naks on
/// `error` or trap, and under `ack-mode: manual` the host acks nothing and the
/// handle is the only path.
@since(version = 0.1.0)
interface jetstream-handler {
  @since(version = 0.1.0)
  use jetstream.{message-handle};

  @since(version = 0.1.0)
  handle-message: func(handle: message-handle) -> result<_, string>;
}

/// Handler for core NATS subscriptions. No ack semantics.
@since(version = 0.1.0)
interface core-handler {
  @since(version = 0.1.0)
  use types.{nats-message};

  @since(version = 0.1.0)
  handle-message: func(msg: nats-message) -> result<_, string>;
}

/// Handler for KV watch events.
@since(version = 0.1.0)
interface kv-handler {
  @since(version = 0.1.0)
  use kv.{entry};

  @since(version = 0.1.0)
  handle-event: func(bucket: string, entry: entry) -> result<_, string>;
}
