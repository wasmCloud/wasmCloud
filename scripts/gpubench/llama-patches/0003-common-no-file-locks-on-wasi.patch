+#if defined(__wasi__)
+// wasi-libc declares flock but has no file locks. A WASI guest is one
+// process with its own preopens, so there is nothing to lock against.
+#define flock(fd, op) (errno = ENOSYS, -1)
+#endif
+
 common_file_lock::common_file_lock(const std::string & lock_path) {
     this->lock_path = lock_path;
