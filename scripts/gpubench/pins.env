# Every external input the GPU benches build from, in one place. Sourced by
# lib/common.sh. Bump a pin here and nowhere else, and record the reason in
# the commit: a pin change moves the numbers.

# llama.cpp: one commit for all three steps of the gap bench.
LLAMA_CPP_REPO=https://github.com/ggml-org/llama.cpp.git
LLAMA_CPP_TAG=b12135
LLAMA_CPP_COMMIT=553d2c2e7ec67307b44d6264ded5e3d6fce5b1b9

# wasi-sdk for the wasm32-wasip3 build (llama.cpp needs 34+ for the EH runtime).
WASI_SDK_VERSION=34
WASI_SDK_SHA256_ARM64_MACOS=9c59398106b417f8f14913380fdf0097a8cc0ff4af9eb3ce0065a859e88d49e9
WASI_SDK_SHA256_X86_64_LINUX=b761e3a0721dbae9c09a0059e5fdb2bf917d1b4a8a7b430fb3b5aafb0984b2c4

# Dawn's C++ wrapper (webgpu_cpp.h) only. No Dawn runtime is built or linked:
# the WebGPU steps put wgpu underneath it. Same pin llama.cpp's build-wasi.yml uses.
DAWN_HEADERS_RELEASE=v20260908.214631
DAWN_HEADERS_COMMIT=94c3c9cc0d5fb2e85aebb370fa8d37b71aa34655
DAWN_HEADERS_SHA256=b8fad919ef0fe396aff97d0910844884d73f4dc8ab139da59623a7fadefa9b76

# webgpu.h implemented on wasi:webgpu (step 3). Imports wasi:webgpu@0.3.0-rc.2,
# the version wash-runtime's host provides.
WASI_WEBGPU_HEADERS_REPO=https://github.com/wasi-gfx/wasi-webgpu-headers.git
WASI_WEBGPU_HEADERS_COMMIT=917765edd7cb8f8cf95bda1217514c78f71b582b

# webgpu.h implemented on wgpu-core (step 2). Built from source with its
# wgpu-core/wgpu-hal/wgpu-types/naga forced to the versions in this repo's
# Cargo.lock, so steps 2 and 3 run the same WebGPU implementation.
WGPU_NATIVE_REPO=https://github.com/gfx-rs/wgpu-native.git
WGPU_NATIVE_TAG=v29.0.1.1
WGPU_NATIVE_COMMIT=6aed50955d934ac36049ba8d002034841633ae02
