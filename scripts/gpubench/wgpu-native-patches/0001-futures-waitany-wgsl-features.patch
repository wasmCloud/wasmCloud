+//! Futures for the webgpu.h async entry points, and `wgpuInstanceWaitAny`.
+//!
+//! Every async entry point hands out an id. Ones whose callback has already
+//! run when they return (adapter and device requests, error scopes) hand out
+//! an id that is complete from the start; buffer maps and queue work-done
+//! callbacks stay pending until wgpu-core runs their callback during a poll.
+
+use std::collections::BTreeSet;
+use std::sync::atomic::{AtomicU64, Ordering};
+use std::time::{Duration, Instant};
+
+use parking_lot::Mutex;
+
+use crate::native;
+
+static NEXT_ID: AtomicU64 = AtomicU64::new(1);
+static PENDING: Mutex<BTreeSet<u64>> = Mutex::new(BTreeSet::new());
+
+/// A future whose callback runs later; pass its id to [`complete`] when it does.
+pub fn issue() -> u64 {
+    let id = NEXT_ID.fetch_add(1, Ordering::Relaxed);
+    PENDING.lock().insert(id);
+    id
+}
+
+pub fn complete(id: u64) {
+    PENDING.lock().remove(&id);
+}
+
+/// A future whose callback has already run.
+pub fn ready() -> native::WGPUFuture {
+    native::WGPUFuture {
+        id: NEXT_ID.fetch_add(1, Ordering::Relaxed),
+    }
+}
+
+fn mark(futures: &mut [native::WGPUFutureWaitInfo]) -> bool {
+    let pending = PENDING.lock();
+    let mut any = false;
+    for f in futures.iter_mut() {
+        let done = !pending.contains(&f.future.id);
+        f.completed = done as native::WGPUBool;
+        any |= done;
+    }
+    any
+}
+
+#[no_mangle]
+pub unsafe extern "C" fn wgpuInstanceWaitAny(
+    instance: native::WGPUInstance,
+    future_count: usize,
+    futures: *mut native::WGPUFutureWaitInfo,
+    timeout_ns: u64,
+) -> native::WGPUWaitStatus {
+    let instance = instance.as_ref().expect("invalid instance");
+    if future_count == 0 {
+        return native::WGPUWaitStatus_TimedOut;
+    }
+    let futures = std::slice::from_raw_parts_mut(futures, future_count);
+    if futures.iter().any(|f| f.future.id == 0) {
+        return native::WGPUWaitStatus_Error;
+    }
+    let deadline = Instant::now().checked_add(Duration::from_nanos(timeout_ns));
+    loop {
+        if mark(futures) {
+            return native::WGPUWaitStatus_Success;
+        }
+        if timeout_ns == 0 || deadline.is_some_and(|d| Instant::now() >= d) {
+            return native::WGPUWaitStatus_TimedOut;
+        }
+        // Waits for submitted work, running the map and work-done callbacks
+        // it completes. A future no queue work will complete would spin here,
+        // as it would block under Dawn.
+        if let Err(cause) = instance.context.poll_all_devices(true) {
+            crate::handle_error_fatal(cause, "wgpuInstanceWaitAny");
+        }
+    }
+}
+
+/// Answered as the `wasi:webgpu` host answers it: a WGSL language extension
+/// is supported when naga implements it.
+#[no_mangle]
+pub extern "C" fn wgpuInstanceHasWGSLLanguageFeature(
+    _instance: native::WGPUInstance,
+    feature: native::WGPUWGSLLanguageFeatureName,
+) -> bool {
+    use wgc::naga::front::wgsl::LanguageExtension;
+    let name = match feature {
+        native::WGPUWGSLLanguageFeatureName_ReadonlyAndReadwriteStorageTextures => {
+            "readonly_and_readwrite_storage_textures"
+        }
+        native::WGPUWGSLLanguageFeatureName_Packed4x8IntegerDotProduct => {
+            "packed_4x8_integer_dot_product"
+        }
+        native::WGPUWGSLLanguageFeatureName_UnrestrictedPointerParameters => {
+            "unrestricted_pointer_parameters"
+        }
+        native::WGPUWGSLLanguageFeatureName_PointerCompositeAccess => "pointer_composite_access",
+        native::WGPUWGSLLanguageFeatureName_UniformBufferStandardLayout => {
+            "uniform_buffer_standard_layout"
+        }
+        native::WGPUWGSLLanguageFeatureName_SubgroupId => "subgroup_id",
+        native::WGPUWGSLLanguageFeatureName_SubgroupUniformity => "subgroup_uniformity",
+        native::WGPUWGSLLanguageFeatureName_TextureAndSamplerLet => "texture_and_sampler_let",
+        native::WGPUWGSLLanguageFeatureName_TextureFormatsTier1 => "texture_formats_tier1",
+        native::WGPUWGSLLanguageFeatureName_LinearIndexing => "linear_indexing",
+        _ => return false,
+    };
+    matches!(
+        LanguageExtension::from_ident(name),
+        Some(LanguageExtension::Implemented(_))
+    )
+}
