From fe2d163f9b931d7a0eccf4c8b7c2cb8817bf9149 Mon Sep 17 00:00:00 2001
From: Liam Randall <liam@cosmonic.com>
Date: Thu, 5 Nov 2026 22:39:32 -0600
Subject: [PATCH 1/2] macOS: reset clean no-image memory slots in place, not
 with mmap

On platforms other than Linux, decommit_behavior() is Zero, so every
freed pooled linear memory is reset with reset_with_anon_memory: an
mmap(MAP_FIXED) over the whole slot. keep_resident is ignored. On XNU
that mmap takes the process vm_map lock exclusively, so instance
teardown serializes across threads; in a scale-to-zero benchmark on an
18-core M5 Max, instantiate-per-request throughput peaked at 4 cores
and fell from 35k to 22k req/s by 18.

When the slot has no image and linear_memory_keep_resident > 0, use
mincore(2) to find the pages of 0..accessible the process has touched.
If they fit in keep_resident, memset just those to zero and leave the
slot mapped, which is the clean-slot invariant (0..accessible R+W and
zero). Otherwise fall back to reset_with_anon_memory, unchanged.

A page counts as touched if any mincore bit other than
MINCORE_ANONYMOUS (0x80) is set: XNU sets that bit on every anonymous
page, touched or not. In-core, modified, paged-out and compressed pages
are all zeroed, so nothing survives into the next instance.

With keep_resident = 256 KiB on the same benchmark: 22k -> 103k req/s,
p99 24 -> 5 ms. Up to keep_resident bytes per freed slot stay resident.
---
 src/runtime/vm/cow.rs | 52 +++++++++++++++++++++++++++++++++++++++++++
 1 file changed, 52 insertions(+)

diff --git a/src/runtime/vm/cow.rs b/src/runtime/vm/cow.rs
index 398d86f..55d66ff 100644
--- a/src/runtime/vm/cow.rs
+++ b/src/runtime/vm/cow.rs
@@ -565,6 +565,23 @@ impl MemoryImageSlot {
     ) -> Result<usize> {
         match vm::decommit_behavior() {
             DecommitBehavior::Zero => {
+                // EXPERIMENT (macOS): with no image, a clean slot only needs
+                // `0..accessible` zeroed. Remapping it with `mmap(MAP_FIXED)`
+                // takes the process's vm_map lock exclusively, which
+                // serializes every instance teardown across threads. When the
+                // pages the guest ever touched fit in `keep_resident`, zero
+                // just those in place instead; `mincore` finds them under a
+                // shared lock. Any page state other than "never touched"
+                // (resident, compressed, paged out) is zeroed, so no data
+                // survives into the next instance.
+                #[cfg(target_os = "macos")]
+                if self.image.is_none()
+                    && keep_resident.byte_count() > 0
+                    && let Some(resident) = unsafe { self.zero_touched_pages(keep_resident) }
+                {
+                    return Ok(resident);
+                }
+
                 // If we're not on Linux then there's no generic platform way to
                 // reset memory back to its original state, so instead reset memory
                 // back to entirely zeros with an anonymous backing.
@@ -747,6 +764,41 @@ impl MemoryImageSlot {
         self.dirty
     }
 
+    /// Zero, in place, every page of `0..accessible` the process has ever
+    /// touched, if those total at most `keep_resident`. Returns the bytes left
+    /// resident, or `None` (having changed nothing) when `mincore` fails or
+    /// too much was touched, so the caller falls back to remapping.
+    #[cfg(target_os = "macos")]
+    unsafe fn zero_touched_pages(&mut self, keep_resident: HostAlignedByteCount) -> Option<usize> {
+        let len = self.accessible.byte_count();
+        if len == 0 {
+            return Some(0);
+        }
+        let page = crate::runtime::vm::host_page_size();
+        let pages = len / page;
+        let mut state: Vec<libc::c_char> = vec![0; pages];
+        let base = self.base.as_mut_ptr();
+        // SAFETY: `base..base+len` is this slot's accessible, mapped range.
+        if unsafe { libc::mincore(base.cast(), len, state.as_mut_ptr()) } != 0 {
+            return None;
+        }
+        // macOS sets MINCORE_ANONYMOUS (0x80) on every anonymous page, touched
+        // or not; any other bit (in core, modified, paged out, copied, ...)
+        // means the page may hold data.
+        let touched_page = |s: &libc::c_char| (*s as u8) & 0x7f != 0;
+        let touched = state.iter().filter(|s| touched_page(s)).count();
+        if touched * page > keep_resident.byte_count() {
+            return None;
+        }
+        for (i, s) in state.iter().enumerate() {
+            if touched_page(s) {
+                // SAFETY: page `i` lies inside the accessible R+W range.
+                unsafe { core::ptr::write_bytes(base.add(i * page), 0, page) };
+            }
+        }
+        Some(touched * page)
+    }
+
     /// Map anonymous zeroed memory across the whole slot,
     /// inaccessible. Used both during instantiate and during drop.
     pub(crate) fn reset_with_anon_memory(&mut self) -> Result<()> {
