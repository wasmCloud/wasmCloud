package wasmcloud:host@0.1.7;

/// Provided by the host to a component plugin that exports
/// `workload-lifecycle`: the keys of a binding filled from a plugin-backed
/// `secrets:` entry, which `interface-binding.config` leaves out. A plugin
/// that does not import this interface is refused a binding that holds one.
@since(version = 0.1.6)
interface binding-secrets {
    use wasmcloud:secrets/store@2.1.0.{secret};

    /// Each secret key of the workload's binding of `namespace:package`
    /// labeled `name`, sorted by key, as a `wasmcloud:secrets` handle the
    /// plugin owns. Read its value with `wasmcloud:secrets/reveal`.
    ///
    /// Answers only inside `on-workload-bind`, about the workload being
    /// bound; anywhere else, or for a binding that workload does not have,
    /// it returns an error. A bind still running after the host timed it out
    /// gets an error too. Each call hands over fresh handles.
    @since(version = 0.1.6)
    get: func(namespace: string, %package: string, name: option<string>) -> result<list<tuple<string, secret>>, string>;
}
