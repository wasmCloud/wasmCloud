package wasmcloud:host@0.1.8;

/// `secret-source`, with the owner the control plane verified for the
/// workload whose bind needs the values. A workload's `name` is chosen by its
/// start request, so any workload in the namespace can claim it; its owner
/// cannot be claimed. Export this instead of `secret-source` to scope an
/// answer by owner, such as choosing a backend path per deployment.
///
/// Catalog entries, grants, withheld keys and routing work as `secret-source`
/// describes. A host that predates this interface refuses a plugin that
/// exports it. A plugin that exports both is called only through this one,
/// but the host still checks both exports against their WIT and refuses the
/// plugin if either does not match.
@since(version = 0.1.8)
interface owned-secret-source {
    @since(version = 0.1.8)
    use types.{plugin-id, binding-name, workload-id};

    /// A key in this plugin's backend, as written under the catalog entry's
    /// `keys`.
    @since(version = 0.1.8)
    type secret-key = string;

    /// A secret's value: text, or bytes for binary material such as a DER key.
    @since(version = 0.1.8)
    variant secret-value {
        %string(string),
        bytes(list<u8>),
    }

    /// Why a `resolve` failed. The host fails the bind and logs the case and
    /// message, so a message must never contain a secret value.
    @since(version = 0.1.8)
    variant source-error {
        /// These requested keys do not exist.
        not-found(list<secret-key>),
        /// This plugin refuses to give these keys to this requester.
        access-denied(option<string>),
        /// The backend could not be reached. The bind can be retried.
        unavailable(option<string>),
        /// Any other failure.
        other(option<string>),
    }

    /// The binding the values are delivered to.
    @since(version = 0.1.8)
    record consumer {
        /// The `host.plugins` entry whose binding names this source.
        plugin: plugin-id,
        /// The binding that names this source, or `none` when the entry itself
        /// does (every binding of `plugin`).
        binding: option<binding-name>,
    }

    /// The object that controls a workload's replicas, in the workload's
    /// namespace, as the control plane verified it before the host started
    /// the workload. Under the Kubernetes operator this is, for example, kind
    /// `WorkloadDeployment`, its name and its UID, and a Workload with no
    /// controller is its own owner. Kinds keep names apart, and the UID keeps
    /// an object recreated under the same name apart from the one it replaced.
    @since(version = 0.1.8)
    record workload-owner {
        kind: string,
        name: string,
        uid: string,
    }

    /// The workload whose bind needs the values.
    @since(version = 0.1.8)
    record workload {
        /// This replica.
        id: workload-id,
        /// The name it keeps across replicas. Any workload in the namespace
        /// can claim it, so scope by `owner` instead.
        name: string,
        namespace: string,
        /// Its owner, or `none` when the host was told none, as a standalone
        /// host's start request may leave it.
        owner: option<workload-owner>,
    }

    /// What the host needs, and for whom. Every field comes from the host's
    /// own records, never from anything a workload sends.
    @since(version = 0.1.8)
    record request {
        consumer: consumer,
        workload: workload,
        /// Keys to resolve, with no duplicates.
        keys: list<secret-key>,
    }

    /// Resolve every key in `request.keys`. `ok` pairs each requested key with
    /// its value, exactly once, and nothing else; a key that does not exist is
    /// `not-found`.
    @since(version = 0.1.8)
    resolve: async func(request: request) -> result<list<tuple<secret-key, secret-value>>, source-error>;
}

/// A host component plugin that serves the host secrets for plugins'
/// bindings, told each workload's owner. Include it in the plugin's world; the
/// host checks the export against it when the plugin registers.
@since(version = 0.1.8)
world owned-secret-source-provider {
    export owned-secret-source;
}
