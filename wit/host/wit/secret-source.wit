package wasmcloud:host@0.1.5;

/// Optionally exported by a host component plugin that holds secrets the
/// operator wants to feed into *other* plugins' bindings. The host calls it,
/// never a workload, so it is separate from any workload-facing secrets
/// interface the plugin also serves.
///
/// An operator names a plugin-backed entry in the host's `secrets:` catalog
/// and lists it under a `host.plugins` binding's `secretFrom`:
///
/// ```yaml
/// secrets:
///   billing-db:
///     plugin: vault-secrets
///     keys:
///       url: apps/billing/pg-url   # config key: key passed to `resolve`
/// ```
///
/// Each time a workload binds a binding that names the entry, the host calls
/// `resolve` once with the entry's keys and hands the values to the consuming
/// plugin as config. A rotated value reaches the next bind.
///
/// Inside `resolve`, `identity.get-caller` returns `host`: the call is on no
/// workload's behalf. The `request` names who the values are for.
@since(version = 0.1.5)
interface secret-source {
    @since(version = 0.1.5)
    use types.{plugin-id, binding-name};

    /// A key in this plugin's backend, as written under the catalog entry's
    /// `keys`.
    @since(version = 0.1.5)
    type secret-key = string;

    /// Why a `resolve` failed. The host fails the bind and logs the case and
    /// message, so a message must never contain a secret value.
    @since(version = 0.1.5)
    variant source-error {
        /// This plugin refuses to give these keys to `consumer`.
        access-denied(option<string>),
        /// The backend could not be reached. The bind can be retried.
        unavailable(option<string>),
        /// Any other failure.
        other(option<string>),
    }

    /// What the host needs, and for whom.
    @since(version = 0.1.5)
    record request {
        /// The plugin the values are for: the `host.plugins` entry whose
        /// binding names this source.
        consumer: plugin-id,
        /// The binding that names this source, or `none` when the entry
        /// itself does (every binding of `consumer`).
        binding: option<binding-name>,
        /// Keys to resolve, with no duplicates.
        keys: list<secret-key>,
    }

    /// Resolve every key in `request.keys`. Return one value per key, paired
    /// with the key it answers. A key missing from the answer fails the bind,
    /// so `ok` with some keys left out is the way to say "not found".
    @since(version = 0.1.5)
    resolve: async func(request: request) -> result<list<tuple<secret-key, string>>, source-error>;
}

/// A host component plugin that serves the host secrets for other plugins'
/// bindings. Include it in the plugin's world; the host checks the export
/// against it when the plugin instantiates.
@since(version = 0.1.5)
world secret-source-provider {
    export secret-source;
}
