package wasmcloud:host@0.1.5;

/// Optionally exported by a host component plugin that holds secrets the
/// operator wants to feed into plugins' bindings, including the
/// `wasmcloud:secrets` bindings workloads read their own secrets through. The
/// host calls it, never a workload, so it is separate from any workload-facing
/// secrets interface the plugin also serves.
///
/// An operator names a plugin-backed entry in the host's `secrets:` catalog
/// and lists it under a `host.plugins` binding's `secretFrom`:
///
/// ```yaml
/// secrets:
///   billing-db:
///     plugin: vault-secrets
///     keys:
///       url: apps/billing/pg-url   # config key: key passed to `resolve`
/// ```
///
/// Each time a workload binds a binding that names the entry, the host calls
/// `resolve` once with the entry's keys and hands the values to the consuming
/// plugin as config. A rotated value reaches the next bind.
///
/// The `request` says whom the values are for: the consuming binding and the
/// workload whose bind needs them. Both come from the host's own records,
/// never from anything a workload sends.
@since(version = 0.1.5)
interface secret-source {
    @since(version = 0.1.5)
    use types.{plugin-id, binding-name, workload-id};

    /// A key in this plugin's backend, as written under the catalog entry's
    /// `keys`.
    @since(version = 0.1.5)
    type secret-key = string;

    /// A secret's value: text, or bytes for binary material such as a DER key.
    @since(version = 0.1.5)
    variant secret-value {
        %string(string),
        bytes(list<u8>),
    }

    /// Why a `resolve` failed. The host fails the bind and logs the case and
    /// message, so a message must never contain a secret value.
    @since(version = 0.1.5)
    variant source-error {
        /// These requested keys do not exist.
        not-found(list<secret-key>),
        /// This plugin refuses to give these keys to this requester.
        access-denied(option<string>),
        /// The backend could not be reached. The bind can be retried.
        unavailable(option<string>),
        /// Any other failure.
        other(option<string>),
    }

    /// The binding the values are delivered to.
    @since(version = 0.1.5)
    record consumer {
        /// The `host.plugins` entry whose binding names this source.
        plugin: plugin-id,
        /// The binding that names this source, or `none` when the entry itself
        /// does (every binding of `plugin`).
        binding: option<binding-name>,
    }

    /// The workload whose bind needs the values.
    @since(version = 0.1.5)
    record workload {
        id: workload-id,
        name: string,
        namespace: string,
    }

    /// What the host needs, and for whom.
    @since(version = 0.1.5)
    record request {
        consumer: consumer,
        workload: workload,
        /// Keys to resolve, with no duplicates.
        keys: list<secret-key>,
    }

    /// Resolve every key in `request.keys`. `ok` pairs each requested key with
    /// its value, exactly once, and nothing else; a key that does not exist is
    /// `not-found`.
    @since(version = 0.1.5)
    resolve: async func(request: request) -> result<list<tuple<secret-key, secret-value>>, source-error>;
}

/// A host component plugin that serves the host secrets for plugins'
/// bindings. Include it in the plugin's world; the host checks the export
/// against it when the plugin registers.
@since(version = 0.1.5)
world secret-source-provider {
    export secret-source;
}
